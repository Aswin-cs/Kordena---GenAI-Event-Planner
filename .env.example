# ==============================================================================
# Kordena — GenAI Event Planner Environment Variables (.env.example)
# Copy this file to .env.local and populate the values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MongoDB via Mongoose)
# ------------------------------------------------------------------------------
# MongoDB connection URI (Atlas cloud cluster or local daemon)
# Local example: mongodb://127.0.0.1:27017/kordena_event_planner
# Cloud example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/kordena?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/kordena_event_planner

# ------------------------------------------------------------------------------
# 2. GOOGLE OAUTH 2.0 CONFIGURATION
# ------------------------------------------------------------------------------
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
# Authorized redirect URI in development: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ------------------------------------------------------------------------------
# 3. NEXTAUTH SESSION AUTHENTICATION
# ------------------------------------------------------------------------------
# Canonical URL of your application
NEXTAUTH_URL=http://localhost:3000

# Random string used to hash tokens and encrypt session cookies
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_key_change_in_production

# ------------------------------------------------------------------------------
# 4. GOOGLE GEMINI GENAI API
# ------------------------------------------------------------------------------
# Obtain from Google AI Studio: https://aistudio.google.com/app/apikey
# Powers AI event blueprint generation and Kordena Copilot advisor
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 5. APPLICATION RUNTIME
# ------------------------------------------------------------------------------
NODE_ENV=development
