+.kchat-headtext { min-width: 0; flex: 1; }
+.kchat-headtext h3 { margin: 0; font: 500 22px/1.1 var(--font-display), Georgia, serif; letter-spacing: -.01em; color: #fff; }
+.kchat-headtext p { margin: 3px 0 0; font-size: 12.5px; color: rgba(243,231,201,.65); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.kchat-tools { display: flex; gap: 2px; }
+.kchat-ghost { width: 34px; height: 34px; border-radius: 999px; display: grid; place-items: center; color: rgba(243,231,201,.75); cursor: pointer; transition: background .15s, color .15s; }
+.kchat-ghost:hover { background: rgba(255,255,255,.1); color: #fff; }
+.kchat-ghost.is-on { color: var(--k-gold); background: rgba(176,141,79,.18); }
+.kchat-ghost--md { display: none; }
+@media (min-width: 768px) { .kchat-ghost--md { display: grid; } }
+
+/* API key drawer */
+.kchat-key { padding: 12px 22px; background: var(--k-gold-soft); border-bottom: 1px solid var(--k-hair); font-size: 12.5px; }
+.kchat-key label { display: block; margin-bottom: 8px; font-weight: 600; color: #7d6230; }
+.kchat-key div { display: flex; gap: 8px; }
+.kchat-key input { flex: 1; height: 36px; padding: 0 12px; border-radius: 10px; border: 1px solid var(--k-hair); background: #fff; font-size: 13px; }
+.kchat-key button { padding: 0 16px; border-radius: 10px; background: var(--k-ink); color: #fff; font-weight: 700; cursor: pointer; }
+
+/* Tabs */
+.kchat-tabs { display: flex; gap: 22px; padding: 0 22px; border-bottom: 1px solid var(--k-hair); overflow-x: auto; flex-shrink: 0; scrollbar-width: none; }
+.kchat-tabs::-webkit-scrollbar { display: none; }
+.kchat-tabs button { position: relative; padding: 14px 0 12px; font-size: 13.5px; font-weight: 600; color: var(--k-muted); white-space: nowrap; cursor: pointer; transition: color .15s; }
+.kchat-tabs button:hover { color: var(--k-ink); }
+.kchat-tabs button.is-active { color: var(--k-ink); }
+.kchat-tabs button.is-active::after { content: ""; position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; border-radius: 2px; background: var(--k-gold); }
+
+.kchat-main { flex: 1; display: flex; min-height: 0; }
+.kchat-col { flex: 1; display: flex; flex-direction: column; min-width: 0; }
+
+/* Lock banner */
+.kchat-lock { display: flex; align-items: center; gap: 10px; padding: 10px 22px; background: var(--k-gold-soft); color: #7d6230; font-size: 13px; font-weight: 500; flex-shrink: 0; }
+.kchat-lock span { flex: 1; }
+.kchat-lock button, .kchat-cta { padding: 6px 14px; border-radius: 999px; background: var(--k-ink); color: #f3e7c9; font-size: 12.5px; font-weight: 700; cursor: pointer; }
+.kchat-cta { margin-top: 12px; padding: 9px 18px; }
+
+/* Messages */
+.kchat-log { flex: 1; overflow-y: auto; padding: 22px 22px 8px; display: flex; flex-direction: column; gap: 22px; font-size: 14px; line-height: 1.6; }
+.kchat-msg { display: flex; gap: 12px; align-items: flex-start; }
+.kchat-msg--user { flex-direction: column; align-items: flex-end; gap: 4px; }
+.kchat-msg--user .kchat-body { max-width: 88%; padding: 11px 16px; border-radius: 20px 20px 6px 20px; background: var(--k-ink); color: #f7f3e8; font-weight: 500; }
+.kchat-avatar { width: 26px; height: 26px; margin-top: 2px; border-radius: 50%; display: grid; place-items: center; background: var(--k-gold-soft); color: var(--k-gold); border: 1px solid #e6d9bb; flex-shrink: 0; }
+.kchat-msg--bot .kchat-body { flex: 1; min-width: 0; color: var(--k-text); }
+.kchat-p { margin: 2px 0; }
+.kchat-p strong, .kchat-li strong, .kchat-num strong { color: var(--k-ink); font-weight: 700; }
+.kchat-li { display: flex; gap: 10px; margin: 6px 0; }
+.kchat-li-dot { width: 5px; height: 5px; margin-top: 10px; border-radius: 50%; background: var(--k-gold); flex-shrink: 0; }
+.kchat-num { margin: 8px 0; }
+.kchat-time { font-size: 11.5px; color: var(--k-muted); margin-right: 4px; }
+.kchat-meta { display: flex; align-items: center; gap: 14px; margin-top: 10px; font-size: 12px; color: var(--k-muted); }
+.kchat-meta button { display: inline-flex; align-items: center; gap: 5px; padding: 3px 8px; margin-left: -8px; border-radius: 999px; cursor: pointer; transition: background .15s, color .15s; }
+.kchat-meta button:hover { background: var(--k-hair); color: var(--k-ink); }
+.kchat-applied { display: inline-flex; align-items: center; gap: 8px; margin-bottom: 10px; padding: 7px 14px 7px 10px; border-radius: 999px; background: var(--k-gold-soft); border: 1px solid #e6d9bb; color: #7d6230; font-size: 13px; font-weight: 700; }
+
+/* Thinking */
+.kchat-think { display: flex; align-items: center; gap: 12px; padding-left: 38px; font-size: 13px; color: var(--k-muted); }
+.kchat-dots { display: inline-flex; gap: 4px; }
+.kchat-dots i { width: 6px; height: 6px; border-radius: 50%; background: var(--k-gold); animation: kchat-bounce 1.2s infinite ease-in-out; }
+.kchat-dots i:nth-child(2) { animation-delay: .15s; } .kchat-dots i:nth-child(3) { animation-delay: .3s; }
+@keyframes kchat-bounce { 0%, 80%, 100% { opacity: .3; transform: translateY(0); } 40% { opacity: 1; transform: translateY(-3px); } }
+
+/* Starters + chips */
+.kchat-starters { display: grid; gap: 8px; margin-top: 4px; }
+.kchat-starters p { margin: 0 0 2px; font: 500 17px var(--font-display), Georgia, serif; color: var(--k-ink); }
+.kchat-starters button { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 13px 16px; border-radius: 16px; border: 1px solid var(--k-hair); background: #fff; text-align: left; font-size: 13.5px; font-weight: 600; color: var(--k-text); cursor: pointer; transition: border-color .15s, transform .15s, box-shadow .15s; }
+.kchat-starters button svg { color: var(--k-gold); flex-shrink: 0; }
+.kchat-starters button:hover { border-color: var(--k-gold); transform: translateY(-1px); box-shadow: 0 10px 20px -14px rgba(14,42,36,.4); }
+.kchat-chips { display: flex; gap: 8px; padding: 10px 22px 0; overflow-x: auto; flex-shrink: 0; scrollbar-width: none; }
+.kchat-chips::-webkit-scrollbar { display: none; }
+.kchat-chips button { padding: 7px 14px; border-radius: 999px; border: 1px solid var(--k-hair); background: #fff; font-size: 12.5px; font-weight: 600; color: var(--k-muted); white-space: nowrap; cursor: pointer; transition: all .15s; }
+.kchat-chips button:hover:not(:disabled) { color: var(--k-ink); border-color: var(--k-gold); background: var(--k-gold-soft); }
+
+/* Composer */
+.kchat-composer { display: flex; align-items: center; gap: 8px; margin: 14px 18px 18px; padding: 6px 6px 6px 18px; border-radius: 999px; background: #fff; border: 1px solid #d9e3de; box-shadow: 0 8px 20px -16px rgba(14,42,36,.5); transition: border-color .15s, box-shadow .15s; flex-shrink: 0; }
+.kchat-composer:focus-within { border-color: var(--k-gold); box-shadow: 0 0 0 3px rgba(176,141,79,.18); }
+.kchat-composer input { flex: 1; min-width: 0; height: 36px; border: 0; background: transparent; font-size: 14px; font-weight: 500; color: var(--k-ink); outline: none; }
+.kchat-composer input::placeholder { color: #9aaaa4; }
+.kchat-composer button { width: 38px; height: 38px; border-radius: 50%; display: grid; place-items: center; background: var(--k-ink); color: var(--k-gold); cursor: pointer; transition: transform .15s, opacity .15s; }
+.kchat-composer button:hover:not(:disabled) { transform: scale(1.06); }
+.kchat-composer button:disabled { opacity: .25; cursor: not-allowed; }
+
+/* Live canvas */
+.kchat-canvas { width: 340px; flex-shrink: 0; overflow-y: auto; padding: 22px; border-left: 1px solid var(--k-hair); background: #f7faf8; display: flex; flex-direction: column; gap: 24px; font-size: 13px; }
+.kchat-canvas h4 { margin: 0; font: 500 20px var(--font-display), Georgia, serif; color: var(--k-ink); }
+.kchat-canvas section { display: grid; gap: 10px; }
+.kchat-canvas-row { display: flex; align-items: center; justify-content: space-between; color: var(--k-muted); font-weight: 600; }
+.kchat-canvas-row b { color: var(--k-ink); }
+.kchat-muted { margin: 0; color: var(--k-muted); }
+.kchat-task { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 10px 12px; border-radius: 14px; background: #fff; border: 1px solid var(--k-hair); box-shadow: inset 3px 0 0 var(--k-high); }
+.kchat-task p { margin: 0; font-weight: 700; color: var(--k-ink); }
+.kchat-task span { font-size: 12px; color: var(--k-muted); }
+.kchat-task button { width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; color: var(--k-gold); background: var(--k-gold-soft); cursor: pointer; flex-shrink: 0; }
+.kchat-bar > div { display: flex; justify-content: space-between; gap: 8px; margin-bottom: 5px; color: var(--k-text); }
+.kchat-bar b { color: var(--k-ink); }
+.kchat-bar i { display: block; height: 5px; border-radius: 99px; background: var(--k-hair); overflow: hidden; }
+.kchat-bar u { display: block; height: 100%; border-radius: 99px; background: linear-gradient(90deg, var(--k-ink), var(--k-gold)); text-decoration: none; }
+.kchat-ros { display: flex; justify-content: space-between; gap: 10px; padding: 9px 0; border-bottom: 1px solid var(--k-hair); font-weight: 600; color: var(--k-ink); }
+.kchat-ros:last-child { border-bottom: 0; }
+.kchat-ros time { color: var(--k-muted); font-weight: 500; flex-shrink: 0; }
+
+@media (max-width: 640px) { .kchat { right: 8px; bottom: 8px; border-radius: 22px; } .kchat-head { padding: 14px 12px 12px 16px; } }
