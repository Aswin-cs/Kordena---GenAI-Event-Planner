+.kchat-fab:hover { transform: translateY(-2px); }
+.kchat-badge { display: inline-flex; align-items: center; gap: 4px; padding: 3px 9px; border-radius: 999px; background: rgba(176,141,79,.22); color: #e8d3a2; font-size: 12px; font-weight: 700; }
+.kchat-badge--alert { background: #b5473c; color: #fff; }
+.kchat-kbd { padding: 3px 8px; border-radius: 999px; border: 1px solid rgba(243,231,201,.25); font: 600 11px var(--font-ui), sans-serif; color: rgba(243,231,201,.7); }
+@media (max-width: 640px) { .kchat-kbd { display: none; } .kchat-fab { right: 14px; bottom: 14px; } }
+
+/* Window */
