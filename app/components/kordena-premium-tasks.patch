index 90cb7c5..ad9bc87 100644
--- a/app/globals.css
+++ b/app/globals.css
@@ -200,3 +200,301 @@ body {
   border-top: 1px solid #F8FAFA;
 }
 
+
+/* ==========================================================
+   Premium calendar — "Ink & Champagne"
+   Scoped under .kcal so nothing else in the app changes.
+   ========================================================== */
+.kcal {
+  --k-ink: #0e2a24;
+  --k-text: #24352f;
+  --k-muted: #7b8c86;
+  --k-hair: #e7ede9;
+  --k-gold: #b08d4f;
+  --k-gold-soft: #f5efe2;
+  --k-high: #b5473c;
+  --k-med: #3f5f8f;
+  --k-low: #4f7d68;
+  --k-show: #6d5d96;
+  font-family: var(--font-ui), system-ui, sans-serif;
+  background: #fcfdfc;
+  border: 1px solid var(--k-hair);
+  border-radius: 28px;
+  padding: 32px 32px 22px;
+  box-shadow: 0 1px 0 #fff inset, 0 24px 48px -28px rgba(14, 42, 36, 0.28), 0 2px 6px rgba(14, 42, 36, 0.04);
+}
+
+/* Header */
+.kcal-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 20px; margin-bottom: 26px; }
+.kcal-month { font-family: var(--font-display), Georgia, serif; font-weight: 500; font-size: 44px; line-height: 1; letter-spacing: -0.025em; color: var(--k-ink); margin: 0; }
+.kcal-year { margin-left: 12px; color: var(--k-gold); font-weight: 400; }
+.kcal-sub { margin: 8px 0 0; font-size: 13px; color: var(--k-muted); }
+.kcal-controls { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
+.kcal-nav { display: flex; align-items: center; gap: 2px; }
+.kcal-icon-btn, .kcal-text-btn { height: 36px; border-radius: 999px; color: var(--k-text); font-size: 13px; font-weight: 600; transition: background .15s; cursor: pointer; }
+.kcal-icon-btn { width: 36px; display: grid; place-items: center; }
+.kcal-text-btn { padding: 0 14px; }
+.kcal-icon-btn:hover, .kcal-text-btn:hover { background: var(--k-hair); }
+.kcal-gold-btn { display: inline-flex; align-items: center; gap: 7px; height: 36px; padding: 0 16px; border-radius: 999px; border: 1px solid var(--k-gold); background: var(--k-gold-soft); color: #7d6230; font-size: 13px; font-weight: 700; cursor: pointer; transition: background .15s; }
+.kcal-gold-btn:hover { background: #efe5cf; }
+.kcal-seg { display: inline-flex; padding: 4px; border-radius: 999px; background: var(--k-hair); }
+.kcal-seg button { height: 30px; padding: 0 16px; border-radius: 999px; font-size: 13px; font-weight: 600; text-transform: capitalize; color: var(--k-muted); cursor: pointer; transition: all .2s; }
+.kcal-seg button.is-active { background: var(--k-ink); color: #fff; box-shadow: 0 4px 10px -4px rgba(14, 42, 36, .6); }
+
+/* Legend footer */
+.kcal-legend { display: flex; flex-wrap: wrap; gap: 22px; padding-top: 18px; font-size: 12.5px; color: var(--k-muted); }
+.kcal-legend span { display: inline-flex; align-items: center; gap: 8px; }
+.kcal-legend i { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }
+
+/* Grid chrome */
+.kcal .rbc-calendar { font-family: inherit; color: var(--k-text); }
+.kcal .rbc-month-view, .kcal .rbc-time-view, .kcal .rbc-agenda-view { border: 0; background: transparent; border-radius: 0; box-shadow: none; }
+.kcal .rbc-header { padding: 0 10px 14px; border: 0; background: transparent; text-align: left; font-size: 12.5px; font-weight: 600; letter-spacing: 0; text-transform: none; color: var(--k-muted); }
+.kcal .rbc-month-header { border-bottom: 1px solid var(--k-hair); }
+.kcal .rbc-month-row { border-top: 1px solid var(--k-hair); }
+.kcal .rbc-month-row:first-child { border-top: 0; }
+.kcal .rbc-day-bg + .rbc-day-bg { border-left: 1px solid var(--k-hair); }
+.kcal .rbc-off-range-bg { background: transparent; opacity: 1; }
+.kcal .rbc-off-range .rbc-button-link { color: #c4cfca; }
+.kcal .rbc-today { background: linear-gradient(180deg, rgba(14, 42, 36, .035), transparent 70%); }
+
+/* Date numerals */
+.kcal .rbc-date-cell { padding: 10px 12px 4px; text-align: left; font-size: 0; }
+.kcal .rbc-button-link { font-family: var(--font-display), Georgia, serif; font-size: 17px; font-weight: 500; color: var(--k-ink); display: inline-grid; place-items: center; min-width: 30px; height: 30px; border-radius: 50%; cursor: pointer; }
+.kcal .rbc-date-cell.rbc-now .rbc-button-link { background: var(--k-ink); color: #fff; }
+
+/* Events */
+.kcal .rbc-event.kcal-ev { margin: 2px 8px; width: calc(100% - 16px); padding: 4px 9px; border: 0; border-radius: 8px; font-size: 12px; font-weight: 600; line-height: 1.35; box-shadow: none; outline: none; transition: transform .15s ease, box-shadow .15s ease; }
+.kcal .rbc-event.kcal-ev:hover { transform: translateY(-1px); filter: none; box-shadow: 0 8px 16px -8px rgba(14, 42, 36, .35); }
