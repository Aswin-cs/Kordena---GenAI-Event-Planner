+
+/* Toast */
+.ktask-toast { position: fixed; right: 24px; bottom: 24px; z-index: 60; display: inline-flex; align-items: center; gap: 12px; padding: 12px 20px 12px 12px; border-radius: 999px; background: var(--k-ink); color: #f3e7c9; font-size: 13.5px; font-weight: 600; box-shadow: 0 20px 36px -16px rgba(14,42,36,.6); }
+.ktask-toast span { width: 24px; height: 24px; border-radius: 50%; display: grid; place-items: center; background: rgba(176,141,79,.25); color: #e8d3a2; }
+
+@media (max-width: 640px) {
+  .ktask-head, .ktask-form { padding: 22px 18px; border-radius: 22px; }
+  .ktask-title { font-size: 32px; }
+  .ktask-formgrid { grid-template-columns: 1fr; }
+  .ktask-row { padding: 14px 8px; gap: 12px; flex-wrap: wrap; }
+  .ktask-toast { left: 14px; right: 14px; bottom: 14px; }
+}
+@media (prefers-reduced-motion: reduce) { .ktask * { transition: none !important; } }
