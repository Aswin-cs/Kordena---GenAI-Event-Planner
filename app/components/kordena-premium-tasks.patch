+/* ==========================================================
+   Premium Tasks section — "Ink & Champagne" (light)
+   ========================================================== */
+.ktask {
+  --k-ink: #0e2a24; --k-text: #24352f; --k-muted: #7b8c86; --k-hair: #e7ede9;
